# Mercado Pago — use credenciais de TESTE durante o desenvolvimento
MP_ACCESS_TOKEN=TEST-your-access-token
MP_WEBHOOK_SECRET=your-webhook-signing-secret
# URL pública HTTPS da aplicação (necessária para back_urls e webhook)
PUBLIC_BASE_URL=https://seu-projeto.vercel.app
# Apenas para testes locais com mock; não defina em produção.
# MP_API_BASE=http://localhost:3999
# API local (opcional)
# PORT=3001
# GRACIOU_DB=backend/data/graciou.sqlite
# Painel administrativo local (opcional)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=troque-esta-senha
# Supabase — somente no backend/Vercel, nunca no frontend
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Painel administrativo — defina valores fortes no ambiente da Vercel
ADMIN_EMAIL=
ADMIN_PASSWORD=
