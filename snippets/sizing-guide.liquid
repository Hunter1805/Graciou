<div class="sizing-guide">
  <p class="text-xs text-navy/60 mb-4 font-light">Medidas em centímetros. Em dúvida, suba um tamanho.</p>
  <div class="sizing-guide__table-wrapper overflow-x-auto">
    <table class="sizing-guide__table w-full text-sm text-left" role="table" aria-label="Guia de tamanhos">
      <thead>
        <tr class="text-xs tracking-widest uppercase text-navy/50 border-b border-navy/10">
          <th scope="col" class="pb-3 pr-6 font-medium">Tamanho</th>
          <th scope="col" class="pb-3 pr-6 font-medium">Peito</th>
          <th scope="col" class="pb-3 pr-6 font-medium">Cintura</th>
          <th scope="col" class="pb-3 pr-6 font-medium">Quadril</th>
          <th scope="col" class="pb-3 font-medium">Comprimento</th>
        </tr>
      </thead>
      <tbody class="font-light">
        <tr class="border-b border-navy/5"><td class="py-2.5 pr-6 font-medium">P</td><td class="py-2.5 pr-6">88–93</td><td class="py-2.5 pr-6">73–78</td><td class="py-2.5 pr-6">92–97</td><td class="py-2.5">68</td></tr>
        <tr class="border-b border-navy/5"><td class="py-2.5 pr-6 font-medium">M</td><td class="py-2.5 pr-6">94–99</td><td class="py-2.5 pr-6">79–84</td><td class="py-2.5 pr-6">98–103</td><td class="py-2.5">70</td></tr>
        <tr class="border-b border-navy/5"><td class="py-2.5 pr-6 font-medium">G</td><td class="py-2.5 pr-6">100–107</td><td class="py-2.5 pr-6">85–92</td><td class="py-2.5 pr-6">104–111</td><td class="py-2.5">72</td></tr>
        <tr><td class="py-2.5 pr-6 font-medium">GG</td><td class="py-2.5 pr-6">108–116</td><td class="py-2.5 pr-6">93–101</td><td class="py-2.5 pr-6">112–120</td><td class="py-2.5">74</td></tr>
      </tbody>
    </table>
  </div>
</div>
